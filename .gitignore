# SPDX-License-Identifier: GPL-2.0-only
#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i -c --exclude-per-directory=.gitignore'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
.*
# AUR package metadata: a real tracked file, not a build artifact; the
# release workflow's aur job stamps it in a checkout of the release tag,
# so it has to be in the tree.
!/packaging/aur/logitech-trueforce-dkms/.SRCINFO
# SonarQube Cloud automatic-analysis settings. It only takes effect when
# it is on the default branch, so the `.*` rule above would quietly stop
# it from ever working.
!/.sonarcloud.properties
*.a
*.asn1.[ch]
*.bin
# The TF re-arm init blob logi-launch replays (generated from
# libtrueforce's tf_init_data.h; see the send_tf_rearm comment there).
!/tools/tf-init.bin
*.bz2
*.c.[012]*.*
*.cover
*.dt.yaml
*.dtb
*.dtbo
*.dtb.S
*.dtbo.S
*.dwo
*.elf
*.gcno
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
*.lz4
*.lzma
*.lzo
*.mbx
*.mod
*.mod.c
*.o
*.o.*
*.patch
*.rmeta
*.rpm
*.rsi
*.s
*.so
*.so.dbg
*.su
*.symtypes
*.symversions
*.tab.[ch]
*.tar
*.usyms
*.xz
*.zst
Module.symvers
modules.order

#
# Top-level generic files
#
/linux
/modules-only.symvers
/vmlinux
/vmlinux.32
/vmlinux.map
/vmlinux.symvers
/vmlinux-gdb.py
/vmlinuz
/System.map
/Module.markers
/modules.builtin
/modules.builtin.modinfo
/modules.nsdeps

#
# RPM spec file (make rpm-pkg)
#
/*.spec
/rpmbuild/

#
# Debian directory (make deb-pkg)
#
/debian/

#
# Snap directory (make snap-pkg)
#
/snap/

#
# tar directory (make tar*-pkg)
#
/tar-install/

#
# We don't want to ignore the following even if they are dot-files
#
!.clang-format
!.cocciconfig
!.get_maintainer.ignore
!.gitattributes
!.github/
!.gitignore
!.kunitconfig
!.mailmap
!.rustfmt.toml

#
# Generated include files
#
/include/config/
/include/generated/
/include/ksym/
/arch/*/include/generated/

# stgit generated dirs
patches-*

# quilt's files
patches
series

# ctags files
tags
TAGS

# cscope files
cscope.*
ncscope.*

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

# id-utils files
ID

*.orig
*~
\#*#

#
# Leavings from module signing
#
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets
/all.config
/alldef.config
/allmod.config
/allno.config
/allrandom.config
/allyes.config

# Kconfig savedefconfig output
/defconfig

# Kdevelop4
*.kdev4

# Clang's compilation database file
/compile_commands.json

# Documentation toolchain
sphinx_*/

# Rust analyzer configuration
/rust-project.json

#
# RS50 driver project-specific ignores
#

# Development directory (captures, notes, scripts, manuals)
/dev/

# Build logs
/mainline/logs/

# Compiled Linux tool binaries (source is tracked, binary is not - unlike
# the Windows tools/*.exe cross-compiled artifacts below, these build fine
# with the host toolchain)
/tools/logi-rpm-bridge

# Compiled test binaries (sources are tracked, binaries are not)
/tests/ff_matrix_test
/tests/texture-merge/test_texmerge

# Python bytecode
__pycache__/
*.pyc

# Subagent-driven-development scratch
.superpowers/

# Internal planning/design scratch (not user docs)
/docs/superpowers/

# Built by tools/Makefile with a mingw cross compiler. The probe is a
# diagnostic and stays out of the tree; the range proxy is committed, because
# it is part of the install path and almost nobody running this has a mingw
# cross compiler to build a Windows DLL with. Rebuild and commit it whenever
# tools/tf-range-proxy.c changes: make -C tools
tools/*.exe

# ...with one exception. The relay is a Windows executable that runs inside
# a game's Proton prefix, and NO distro builder can produce one: none of them
# ship a Rust Windows target. So the built artifact is committed and
# installed by every packaging channel, the same bargain tf-range-proxy.dll
# makes. Refresh it with tools/build-relay.sh, never by hand; CI fails if it
# falls behind its sources.
!tools/logi-tf-relay.exe
