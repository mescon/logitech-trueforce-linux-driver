# Logitech TrueForce wheels: hidraw + wheel_* sysfs access
#
# Grants the currently-logged-in desktop user access, with no group
# membership required (systemd-logind uaccess for the hidraw device node;
# world-writable mode on the wheel_* sysfs knobs, which uaccess does not
# cover). This is why the settings apps work with no terminal setup.
#   - /dev/hidraw*  for libtrueforce / userspace tooling and the
#     Logitech SDK DLLs' TrueForce stream under Proton
#   - /sys/class/hidraw/hidrawN/device/wheel_*  for Oversteer, the
#     in-tree sysfs knobs, and user scripts
#
# Without this rule the sysfs knobs are mode 0664 root:root and every
# wheel_* write needs sudo. Mode 0666 lets any local user change wheel
# settings; on a single-user desktop (the norm for a personal wheel) this
# is the friction-free default, matching other Linux wheel udev rules.
#
# Supported USB product IDs (VID 046D), grouped by capability - all get
# the same hidraw access:
#
#   Direct-drive TrueForce wheels (this driver's primary targets):
#     C276  RS50 Direct Drive - NATIVE mode (full sysfs surface)
#     C272  G PRO Racing Wheel (Xbox/PC) - ALSO the RS50 in G PRO
#           COMPATIBILITY mode (the RS50 can present this PID; the
#           driver tells the two apart by USB product string). The SDK
#           also accepts the RS50's native C276, so compat mode is not
#           required for TrueForce.
#     C268  G PRO Racing Wheel (PlayStation/PC)
#
#   Gear-driven, but same TrueForce stream protocol - access is for
#   logi-tf-sim (the interface-2 hidraw node) and logi-wheel, since the
#   SDK's own TrueForce path does not work for the PS G923 under Proton:
#     C266  G923 (PlayStation/PC)
#     C267  G923 (PlayStation 4/PC)
#     C26D  G923 (Xbox/PC, alt PID)
#     C26E  G923 (Xbox/PC)
#
#   No TrueForce - kept only for its range knob:
#     C262  G920 Racing Wheel

ACTION!="add|change", GOTO="trueforce_end"

# The wheel's own /dev/input/event* nodes.
#
# Normally the system rules handle these: 50-udev-default gives input
# devices GROUP="input", and a joystick additionally gets uaccess. Neither
# is guaranteed. On a G923 Xbox whose probe failed and was re-bound, the
# event nodes came up root:root 0600, so the settings apps could not read
# live input at all and reported an unreadable /dev/input/eventN (issue
# #27). Chowning them by hand worked and did not survive a reboot, which is
# exactly what a udev rule is for.
#
# Granting this ourselves for wheels we already claim costs nothing when
# the system rules do work, and removes a silent dependency on them when
# they do not.
SUBSYSTEM=="input", KERNEL=="event*", \
  ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c262|c266|c267|c26d|c26e|c268|c272|c276", \
  GROUP="input", MODE="0660", TAG+="uaccess"

# The G923's rev strip: five LED classdevs, `<hiddev>::RPM1`..`RPM5`.
#
# The DD wheels' rev display is the `wheel_rev_level` attribute handled
# below, which this file already makes world-writable. The G923 has no such
# attribute; its strip is five standard LED classdevs, and those come up
# 0644 root:root with nothing granting a desktop user access. So every
# rev-light write from logi-tf-sim failed silently on a G923 while the
# daemon reported it was driving the display. Found on hardware 2026-08-06,
# by the lights simply never coming on.
#
# Matched on the classdev name plus the parent wheel's USB ids, so this
# cannot touch an unrelated device's LEDs.
SUBSYSTEM=="leds", KERNEL=="*::RPM[1-5]", \
  ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c262|c266|c267|c26d|c26e|c268|c272|c276", \
  RUN+="/bin/sh -c 'f=/sys/class/leds/%k/brightness; [ -e \"$$f\" ] && chmod 0666 \"$$f\"'"

SUBSYSTEM!="hidraw", GOTO="trueforce_end"

# One alternation instead of a GOTO per PID: adding a wheel is a
# five-character diff that cannot forget the GOTO.
ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c262|c266|c267|c26d|c26e|c268|c272|c276", GOTO="trueforce_apply"
GOTO="trueforce_end"

LABEL="trueforce_apply"

# /dev/hidraw* for libtrueforce and direct userspace tooling.
TAG+="uaccess", MODE="0660"

# wheel_* sysfs attributes (only exist on the HID++ interface's hidraw
# node; the RUN invocation is a no-op on interfaces that lack them).
# The wheel_* glob deliberately covers the texture-merge controls too
# (wheel_tf_merge, wheel_texture_rpm, wheel_texture_intensity,
# wheel_texture_cylinders): logi-launch and logi-rpm-bridge write those
# from the user session, so they need the same 0666 as the other knobs.
# Note: "$$f" not "$f" - udev treats a lone "$" as a substitution
# marker, so a literal shell "$f" must be written "$$f" (passes
# udevadm verify; on lenient udev versions "$f" happened to survive
# as a literal, but that is non-portable).
RUN+="/bin/sh -c 'for f in /sys/class/hidraw/%k/device/wheel_* /sys/class/hidraw/%k/device/range /sys/class/hidraw/%k/device/range_restore /sys/class/hidraw/%k/device/gain /sys/class/hidraw/%k/device/autocenter /sys/class/hidraw/%k/device/combine_pedals /sys/class/hidraw/%k/device/damper_level /sys/class/hidraw/%k/device/spring_level /sys/class/hidraw/%k/device/friction_level; do [ -e \"$$f\" ] || continue; chmod 0666 \"$$f\"; done'"

LABEL="trueforce_end"
