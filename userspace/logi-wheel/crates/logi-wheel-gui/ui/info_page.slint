import { Button, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One cell of the Info page's button tester grid: the wheel button's
// evdev code (informational), its label from `evtest::WHEEL_BUTTONS`,
// and whether it is currently held. The Rust reader thread pushes the
// whole list at ~30 Hz while the page is open.
export struct TestButton {
    code: int,
    label: string,
    pressed: bool,
}

// One live axis bar (pedals + handbrake): a label and the raw 0..65535
// value.
export struct TestAxis {
    label: string,
    value: int,
}

// One callout box on the wheel-layout image (`evtest::CALLOUT_BOXES`):
// center and size as fractions of the image dimensions, plus whether its
// button is currently held. Drawn as a green tint over the numbered white
// box, inside the rotated image element so it turns with the artwork.
export struct TestCallout {
    cx: float,
    cy: float,
    w: float,
    h: float,
    pressed: bool,
}

// One row of a confirmed simulation's plan (`fftest::SimStep` + its live
// `fftest::StepState`, both from Rust): the step's label and duration
// text, a state-only word ("pending"/"3..."/"playing"/"done"/"skipped" -
// see `StepState::status_text`, never relying on color alone), and
// `state` (0 pending, 1 counting down, 2 playing, 3 done, 4 skipped) for
// this row's color, a secondary cue only. The whole plan is pushed once
// a simulation is confirmed (every row pending) and again on every step
// event as the run plays; rows are never removed, which is what keeps a
// finished step's row on screen.
export struct TestPlanRow {
    label: string,
    duration-text: string,
    status-text: string,
    state: int,
}

// A small horizontal 0..65535 bar.
component AxisBar inherits Rectangle {
    in property <int> value: 0;
    height: 12px;
    border-radius: 6px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Theme.panel-border;

    Rectangle {
        x: 0;
        width: parent.width * min(max(root.value, 0), 65535) / 65535;
        height: parent.height;
        border-radius: 6px;
        background: Palette.accent-background;
    }
}

// The Info page: device identity (serial, firmware) on top, then the live
// input monitor (the wheel image turning with the live steering angle,
// per-button callout highlights, the full button list beside the image,
// pedal bars, hat state), the two guarded force-feedback simulations, and
// the project documentation link at the bottom. The monitor auto-starts
// whenever this page is open and a wheel evdev node is found; everything
// live is pushed from the Rust reader thread, and the two sim buttons
// round-trip through a confirm dialog before their callbacks ever fire
// (the wheel physically moves).
export component InfoPage inherits Rectangle {
    // Which wheel was detected: the evdev node's own human-readable name
    // when found, else a generic label for the known model. Empty while no
    // wheel is bound at all, shown as its own "No wheel detected" state
    // (not the plain "-" placeholder every other identity row uses).
    in property <string> wheel-name: "";
    // Device identity, read through the driver's sysfs attrs (the registry
    // Info rows); empty strings while no wheel is bound.
    in property <string> serial: "";
    in property <string> firmware: "";
    // Software identity: the running front-end's own name + version
    // ("logi-wheel-gui 0.16.0", from CARGO_PKG_VERSION) and the loaded
    // kernel module's version stamp (/sys/module/hid_logitech_dd/version;
    // "(module not loaded)" when absent). Set on the Rust side.
    in property <string> app-version: "";
    in property <string> driver-version: "";
    // Project home, opened via `open-url` (xdg-open on the Rust side).
    in property <string> project-url: "";
    callback open-url(string);
    // Copy one identity value to the clipboard (best-effort, wl-copy or
    // xclip on the Rust side, same mechanism as the Setup page's launch-
    // options Copy). The firmware value carries its base/motor line
    // break, so it copies as two lines.
    callback copy-value(string);
    // Collect a diagnostic report: everything a bug report needs, with the
    // wheel's serial and the owner's profile names left out. Separate from
    // copy-value above, which copies exactly the identifying values this
    // deliberately omits.
    callback write-report();
    in property <string> report-status: "";

    // Whether a wheel evdev node was found; gates the live monitor body
    // and both sim buttons. `scanned` keeps the empty state from
    // flashing "no wheel" before the first discovery finishes.
    in property <bool> available: false;
    in property <bool> scanned: false;
    in property <string> device-name: "";
    // Steering, pre-converted on the Rust side: the signed degrees for
    // the needle, the formatted readout text, and the configured range.
    in property <float> degrees: 0;
    in property <string> degrees-text: "0.0 deg";
    in property <int> range: 900;
    in property <[TestButton]> buttons: [];
    in property <string> hat: "centered";
    in property <[TestAxis]> axes: [];
    // The layout image's callout boxes, tinted while pressed; see
    // `TestCallout`. Only meaningful over the RS50's numbered layout photo
    // (`wheel-kind` 0): the G PRO/G923 photos are plain product shots with
    // no numbered boxes for these fractions to land on, so the overlay is
    // hidden for those (see `img-area`'s `Image` below).
    in property <[TestCallout]> callouts: [];
    // Which product photo to show below: 0 RS50 (the numbered layout used
    // for the button-callout overlay), 1 G PRO, 2 G923. See
    // `bridge::wheel_image_index` for how a frontend picks this.
    // -1 = not identified (no photo), 0 RS50, 1 G PRO, 2 G923. The default
    // is -1 rather than 0 so a wheel that has not been identified yet, or at
    // all, shows no photo instead of a confident picture of an RS50.
    in property <int> wheel-kind: -1;
    // True while a simulation plays (including a step's countdown lead-
    // in); disables both sim buttons and shows the Stop button.
    in property <bool> sim-running: false;
    in property <string> sim-error: "";
    // The running (or just-finished) sequence's one-line summary (set
    // from Rust; see `App.test-sim-status`) - "starting...", or how the
    // run ended once it stops. The per-step detail lives in `sim-plan`
    // below, not here.
    in property <string> sim-status: "";
    // The confirmed sequence's whole plan, one row per step, in order -
    // pushed the instant a simulation is confirmed (every row pending,
    // before the sequence thread has even opened the device) and again
    // on every step event as the run plays. Stays populated after the
    // run ends (Rust never clears it until the next simulation is
    // confirmed), which is what keeps a finished step's row visible
    // instead of disappearing.
    in property <[TestPlanRow]> sim-plan: [];

    callback rescan();
    // Fired only from the confirm dialog's Continue button, never
    // directly from the sim buttons. Starts the sequence immediately -
    // its own first step's countdown is the only wait, so nothing here
    // stacks a second one on top.
    callback sim-constant();
    callback sim-texture();
    // Stops (and erases) the currently playing simulation immediately,
    // whether it is in a step's countdown or actually playing one.
    callback sim-stop();

    // The confirm dialog's state: 0 closed, 1 constant force, 2 texture.
    private property <int> confirm-kind: 0;

    background: transparent;

    VerticalLayout {
        spacing: Theme.gutter;

        // Device identity + the input-device rescan affordance.
        Rectangle {
            background: Theme.panel-background;
            border-radius: Theme.panel-radius;
            border-width: 1px;
            border-color: Theme.panel-border;

            HorizontalLayout {
                padding: 14px;
                spacing: Theme.gutter;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "Wheel";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.wheel-name == "" ? "No wheel detected" : root.wheel-name;
                            vertical-alignment: center;
                            color: Theme.text-color;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "Serial";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.serial == "" ? "-" : root.serial;
                            vertical-alignment: center;
                            color: Theme.text-color;
                            overflow: elide;
                        }
                        Button {
                            text: "Copy";
                            enabled: root.serial != "";
                            clicked => { root.copy-value(root.serial); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "Firmware";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            // A blank firmware string on a classic (G923)
                            // wheel means the HID++ query itself came up
                            // empty (unsupported, timed out, permissions) -
                            // "Unavailable" says so, rather than the bare
                            // "-" every other blank identity row uses.
                            text: root.firmware == "" ? "Unavailable" : root.firmware;
                            vertical-alignment: center;
                            color: Theme.text-color;
                            wrap: word-wrap;
                        }
                        Button {
                            // Copies both firmware lines (base and motor)
                            // as two lines.
                            text: "Copy";
                            enabled: root.firmware != "";
                            clicked => { root.copy-value(root.firmware); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "App";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.app-version == "" ? "-" : root.app-version;
                            vertical-alignment: center;
                            color: Theme.text-color;
                            overflow: elide;
                        }
                        Button {
                            text: "Copy";
                            enabled: root.app-version != "";
                            clicked => { root.copy-value(root.app-version); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "Bug report";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.report-status == ""
                                ? "Collects versions, settings and rules. Leaves out your serial and profile names."
                                : root.report-status;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            color: root.report-status == "" ? Theme.muted-text-color : Theme.text-color;
                        }
                        Button {
                            text: "Collect";
                            clicked => { root.write-report(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: "Driver";
                            font-weight: 600;
                            vertical-alignment: center;
                            color: Theme.muted-text-color;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.driver-version == "" ? "-" : root.driver-version;
                            vertical-alignment: center;
                            color: Theme.text-color;
                            overflow: elide;
                        }
                        Button {
                            text: "Copy";
                            enabled: root.driver-version != "";
                            clicked => { root.copy-value(root.driver-version); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Rescan";
                        clicked => { root.rescan(); }
                    }
                }
            }
        }

        if !root.available: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 10px;

            Text {
                text: root.scanned ? "No wheel input found" : "Looking for the wheel...";
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
                color: Theme.text-color;
            }
            Text {
                text: root.scanned
                    ? "Connect the wheel to this machine, then press Rescan above.\nThe monitor reads the wheel's /dev/input event device, so your user needs read access to it (the project's udev rule sets this up)."
                    : "Scanning /dev/input for the wheel...";
                horizontal-alignment: center;
                color: Theme.muted-text-color;
                wrap: word-wrap;
            }
            if root.sim-error != "": Text {
                // Discovery found a node but it could not be opened
                // (permissions, ...): surface the reason here too.
                text: root.sim-error;
                horizontal-alignment: center;
                color: Theme.error-color;
                wrap: word-wrap;
            }
        }

        // The live monitor. One panel holds the wheel image (turning with
        // the live steering angle, callout tints riding on it) with the
        // full button list BESIDE it, wrapped into columns so every
        // button is visible at once; pedals and the sims stack below.
        // ScrollView (not a bare Flickable) so the vertical scrollbar
        // becomes visible whenever a short window forces this section to
        // scroll, instead of silently accepting the mouse wheel with no
        // sign there is more below; at the default window size everything
        // fits and the scrollbar stays out of the way (`as-needed`
        // policy, the widget's default). `viewport-width` is pinned to
        // the visible width so nothing ever scrolls sideways.
        if root.available: ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: max(monitor-column.preferred-height, self.height);

            monitor-column := VerticalLayout {
                spacing: Theme.gutter;

                // Section: steering + buttons, side by side.
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel-background;
                    border-radius: Theme.panel-radius;
                    border-width: 1px;
                    border-color: Theme.panel-border;

                    HorizontalLayout {
                        padding: 14px;
                        spacing: Theme.gutter;

                        // Left half: the layout image, rotated by the live
                        // steering angle, with the degrees readout under it.
                        VerticalLayout {
                            horizontal-stretch: 11;
                            spacing: 4px;

                            Text {
                                // The box tests everything (steering, pedals,
                                // buttons, haptics), not just the wheel axis.
                                text: "Test area";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text-color;
                            }
                            Text {
                                text: root.device-name;
                                font-size: 11px;
                                color: Theme.muted-text-color;
                                overflow: elide;
                            }
                            img-area := Rectangle {
                                vertical-stretch: 1;
                                min-height: 230px;
                                // Without a cap the photo grows with the row
                                // and takes width the horizontal-stretch was
                                // supposed to leave for the button panel,
                                // which is what squeezed the labels.
                                max-width: 480px;
                                // Manual `contain` fit: the rotated element
                                // must match the drawn image exactly, so the
                                // callout children can position themselves
                                // as fractions of ITS size (= fractions of
                                // the source image). Each photo keeps its
                                // own native aspect ratio rather than being
                                // squeezed into the RS50 layout's.
                                property <float> aspect: root.wheel-kind == 2 ? 1384.0 / 1038.0 : 2500.0 / 2160.0;
                                property <length> img-w: min(self.width, self.height * self.aspect);

                                // Turned by the live steering angle
                                // (positive degrees = turned right =
                                // clockwise on screen). `transform-rotation`
                                // is the reserved rotation property every
                                // Slint element carries (`rotation-angle`
                                // only exists on Image/Text); it rotates the
                                // element AND its children around
                                // `transform-origin`, which defaults to the
                                // element's center.
                                rotator := Rectangle {
                                    width: img-area.img-w;
                                    height: self.width / img-area.aspect;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    transform-rotation: root.degrees * 1deg;

                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        // RS50 (0): the numbered layout photo
                                        // the callout overlay below is drawn
                                        // against.
                                        //
                                        // The RS50 shot has its background
                                        // removed, so it sits on the page's
                                        // own colour rather than a white
                                        // rectangle.
                                        // Hidden entirely when the wheel is
                                        // unidentified: showing the wrong
                                        // wheel is worse than showing none.
                                        visible: root.wheel-kind >= 0;
                                        source: root.wheel-kind == 2
                                            ? @image-url("assets/g923-wheel.png")
                                            : root.wheel-kind == 1
                                                ? @image-url("assets/g-pro-wheel.png")
                                                : @image-url("assets/rs50-wheel.png");
                                        image-fit: contain;
                                    }
                                    // Pressed-button tints over the RS50
                                    // layout's numbered callout boxes;
                                    // children of `rotator`, so they turn
                                    // with the artwork. Semi-transparent
                                    // green keeps the number readable
                                    // underneath. Only drawn over the RS50
                                    // photo (wheel-kind 0): the G PRO/G923
                                    // photos have no numbered boxes for
                                    // these fractions to land on.
                                    for c in root.callouts: Rectangle {
                                        x: (c.cx - c.w / 2) * rotator.width;
                                        y: (c.cy - c.h / 2) * rotator.height;
                                        width: c.w * rotator.width;
                                        height: c.h * rotator.height;
                                        border-radius: 4px;
                                        background: #00c8538c;
                                        visible: c.pressed && root.wheel-kind == 0;
                                    }
                                }
                                // Shown in place of the photo when the wheel
                                // has not been identified, so the empty space
                                // reads as a known state rather than a
                                // failure to draw.
                                Text {
                                    visible: root.wheel-kind < 0;
                                    text: "Wheel not identified";
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                    color: Theme.muted-text-color;
                                }
                            }
                            Text {
                                text: root.degrees-text;
                                font-size: 20px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                color: Theme.text-color;
                            }
                            Text {
                                text: "Range: \{root.range} deg (\{-root.range / 2} to +\{root.range / 2})";
                                font-size: 12px;
                                horizontal-alignment: center;
                                color: Theme.muted-text-color;
                            }
                        }

                        // Right half: every wheel button as a light-up
                        // chip, wrapped into 2-3 columns (never a scroll
                        // list: the whole set stays visible), with the
                        // D-pad state underneath.
                        VerticalLayout {
                            horizontal-stretch: 9;
                            // horizontal-stretch alone does not widen this
                            // column: the row sizes both halves to their
                            // content and leaves the remainder unused, which
                            // left the grid ~190px however wide the window
                            // was. This floor is what actually reserves the
                            // room the three label columns need.
                            min-width: 430px;
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Buttons";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text-color;
                            }
                            grid := Rectangle {
                                // Fixed, NOT derived from self.width. This
                                // grid's height depends on its row count,
                                // which would depend on the column count,
                                // which would depend on its width: a cycle
                                // (width -> columns -> rows -> height ->
                                // layout -> width) that Slint breaks by
                                // treating the width as 0 here. The previous
                                // `self.width > 440px ? 3 : 2` therefore
                                // always took the false branch and pinned the
                                // grid to 2 columns at every window size,
                                // which combined with the uncapped photo next
                                // door to give ~98px cells. The longest label
                                // ("R Encoder Push") is ~95px at 12px plus
                                // 16px of cell padding, so nearly every label
                                // elided. Verified by probing the binding
                                // with a 300px threshold against a panel
                                // measured at ~560px: still the false branch.
                                property <int> columns: 3;
                                property <int> rows: ceil(root.buttons.length / self.columns);
                                property <length> cell-w: (self.width - (self.columns - 1) * 6px) / self.columns;
                                height: self.rows * 26px;

                                // Column-major: reads top to bottom, then
                                // wraps to the next column.
                                for b[i] in root.buttons: Rectangle {
                                    x: floor(i / grid.rows) * (grid.cell-w + 6px);
                                    y: mod(i, grid.rows) * 26px;
                                    width: grid.cell-w;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: b.pressed ? Palette.accent-background : Palette.alternate-background;

                                    Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        text: b.label;
                                        font-size: 12px;
                                        font-weight: b.pressed ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        color: b.pressed ? Palette.accent-foreground : Theme.text-color;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    width: 80px;
                                    text: "D-pad";
                                    font-size: 12px;
                                    color: Theme.text-color;
                                }
                                Text {
                                    // Fixed width so the row's geometry
                                    // never moves as the hat state changes
                                    // ("centered" vs "down-right", the
                                    // longest label `evtest::hat_label`
                                    // produces): the whole live monitor
                                    // used to jump horizontally on every
                                    // D-pad change before this was pinned.
                                    // Left-aligned within the fixed box, so
                                    // shorter labels never drift right.
                                    width: 90px;
                                    horizontal-alignment: left;
                                    text: root.hat;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-color;
                                }
                            }
                        }
                    }
                }

                // Section: pedals + handbrake bars.
                Rectangle {
                    background: Theme.panel-background;
                    border-radius: Theme.panel-radius;
                    border-width: 1px;
                    border-color: Theme.panel-border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        Text {
                            text: "Pedals";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-color;
                        }
                        // Label and value columns are both fixed-width
                        // (80px / 46px) so a value's digit count (0 vs
                        // 65535) never changes this row's, or the bar's,
                        // geometry - same stabilization as the D-pad row
                        // above.
                        for axis in root.axes: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 80px;
                                text: axis.label;
                                font-size: 12px;
                                vertical-alignment: center;
                                color: Theme.text-color;
                            }
                            AxisBar {
                                horizontal-stretch: 1;
                                value: axis.value;
                            }
                            Text {
                                width: 46px;
                                text: axis.value;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: Theme.muted-text-color;
                            }
                        }
                    }
                }

                // Section: the two guarded force simulations.
                Rectangle {
                    background: Theme.panel-background;
                    border-radius: Theme.panel-radius;
                    border-width: 1px;
                    border-color: Theme.panel-border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Force feedback test";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-color;
                        }
                        Text {
                            text: "Plays a short sequence of labelled steps (constant force both directions, a rising ramp, centering spring, damper, sine vibration) through the wheel's force-feedback path, at moderate strength. The texture test plays a frequency progression (low rumble through high-frequency buzz) through the TrueForce/FFB path. Every step counts down for a few seconds first, so the wheel never moves without warning.";
                            font-size: 12px;
                            color: Theme.muted-text-color;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Simulate force feedback";
                                enabled: root.available && !root.sim-running && root.confirm-kind == 0;
                                clicked => { root.confirm-kind = 1; }
                            }
                            Button {
                                text: "Simulate TrueForce texture";
                                enabled: root.available && !root.sim-running && root.confirm-kind == 0;
                                clicked => { root.confirm-kind = 2; }
                            }
                            if root.sim-running: Button {
                                text: "Stop";
                                clicked => { root.sim-stop(); }
                            }
                        }
                        if root.sim-plan.length > 0: Text {
                            text: root.sim-status;
                            font-size: 12px;
                            font-weight: 700;
                            color: root.sim-running ? Theme.ok-color : Theme.muted-text-color;
                            wrap: word-wrap;
                        }
                        // The whole plan, one row per step: label,
                        // duration, and a state-only word (never color
                        // alone - see `TestPlanRow`). Shown in full the
                        // instant a simulation is confirmed and left in
                        // place after the run ends, so a finished step's
                        // row never disappears.
                        for row in root.sim-plan: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 64px;
                                text: row.status-text;
                                font-size: 12px;
                                font-weight: row.state == 1 || row.state == 2 ? 700 : 400;
                                color: row.state == 1 ? Theme.accent
                                    : row.state == 2 ? Theme.ok-color
                                    : row.state == 4 ? Theme.faint-text-color
                                    : Theme.muted-text-color;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: row.label;
                                font-size: 12px;
                                color: row.state == 4 ? Theme.faint-text-color : Theme.text-color;
                                wrap: word-wrap;
                            }
                            Text {
                                text: row.duration-text;
                                font-size: 12px;
                                color: Theme.muted-text-color;
                            }
                        }
                        if root.sim-error != "": Text {
                            text: root.sim-error;
                            font-size: 12px;
                            color: Theme.error-color;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Documentation / source link, same styling as the link the Setup
        // page carries.
        HorizontalLayout {
            alignment: start;
            spacing: 6px;

            Text {
                text: "Documentation and source:";
                vertical-alignment: center;
                color: Theme.muted-text-color;
            }
            link := Text {
                text: root.project-url;
                vertical-alignment: center;
                color: Palette.accent-background;
                font-weight: 600;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-url(root.project-url); }
                }
            }
        }
    }

    // Confirm dialog, painted over the whole page. No simulation ever
    // fires without pressing Continue here; Continue starts the sequence
    // right away - its own first step carries the same countdown lead-in
    // as every other step (rendered in the panel above, once `sim-plan`
    // is populated), so there is no separate pre-sequence wait to stack
    // on top of it.
    if root.confirm-kind != 0: Rectangle {
        background: Theme.scrim;

        // Swallow clicks outside the dialog panel.
        TouchArea { }

        Rectangle {
            width: min(parent.width - 40px, 420px);
            height: panel-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel-background;
            border-radius: Theme.panel-radius;
            border-width: 1px;
            border-color: Theme.panel-border;

            panel-layout := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: root.confirm-kind == 1 ? "Simulate force feedback" : "Simulate TrueForce texture";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-color;
                }
                Text {
                    text: "The wheel WILL move. Keep hands and objects clear of the rim. Each step counts down for a few seconds before it plays. Continue?";
                    font-size: 13px;
                    color: Theme.text-color;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.confirm-kind = 0; }
                    }
                    Button {
                        text: "Continue";
                        primary: true;
                        clicked => {
                            if (root.confirm-kind == 1) {
                                root.sim-constant();
                            } else {
                                root.sim-texture();
                            }
                            root.confirm-kind = 0;
                        }
                    }
                }
            }
        }
    }
}
