#!/usr/bin/make -f
# DKMS packaging for the Logitech direct-drive wheel driver.
# The module builds as hid-logitech-dd from the historically-named source
# file via the repo Kbuild; DKMS handles the per-kernel build/rebuild.
#
# One source package, three binary packages:
#   logitech-trueforce-dkms  the kernel module source + both udev rules
#   logi-wheel                  the headless toolset (TUI, logi-ffb,
#                            logi-tf-sim, shim installer)
#   logi-wheel-gui              the graphical settings app + desktop entry

include /usr/share/dpkg/pkg-info.mk

NAME := logitech-trueforce
VER  := $(DEB_VERSION_UPSTREAM)
DRV  := $(CURDIR)/debian/logitech-trueforce-dkms
TUI  := $(CURDIR)/debian/logi-wheel
GUI  := $(CURDIR)/debian/logi-wheel-gui
SRC  := $(DRV)/usr/src/$(NAME)-$(VER)

%:
	dh $@ --with dkms

override_dh_auto_build:
	dh_auto_build
	# The userspace companions: logi-ffb (DirectInput FFB proxy), logi-wheel
	# (settings TUI), logi-tf-sim (simulated-TrueForce daemon; its build.rs
	# compiles the in-repo libtrueforce.a with gcc+make, both
	# build-essential), and logi-wheel-gui (Slint settings GUI,
	# GPL-3.0-or-later). The whole workspace now needs a current rustc
	# anyway (the lockfile's TUI dependencies require >= 1.88, Slint 1.17
	# requires >= 1.92), so the GUI no longer gets a tolerated-failure
	# build: it is a declared binary package and must build.
	cargo build --release --manifest-path userspace/logi-wheel/Cargo.toml
	# logi-rpm-bridge: the small C bridge that feeds relayed game RPM to
	# the driver's kernel texture merge; logi-launch starts and stops it
	# around a game session.
	cc -O2 -Wall -o tools/logi-rpm-bridge tools/logi-rpm-bridge.c

override_dh_auto_clean:
	dh_auto_clean
	rm -f tools/logi-rpm-bridge

override_dh_install:
	# Module source DKMS compiles in /usr/src (the .c keeps its historical
	# name; Kbuild emits hid-logitech-dd.ko). dd-lg4ff.c/.h carry the
	# ported classic force-feedback engine for the G923 (c266/c267); the
	# Kbuild links it into the same module.
	install -d $(SRC)
	install -m 0644 mainline/hid-logitech-hidpp.c mainline/dd-lg4ff.c \
		mainline/dd-lg4ff.h mainline/hid-ids.h \
		mainline/hidpp_dd_texture_merge.h \
		mainline/hidpp_dd_tf_init.h mainline/Kbuild mainline/Makefile $(SRC)/
	# Build-time identifier the loaded module reports back (Kbuild reads it).
	echo "v$(VER)" > $(SRC)/.git_hash
	# TrueForce-in-Proton shim installer (no-op unless the user stages the
	# proprietary SDK DLLs; resolves the SDK dir via --sdk-dir /
	# $$LOGITECH_TRUEFORCE_SDK_DIR / ~/.local/share/logitech-trueforce/sdk).
	# Renamed on install, so it cannot come from logi-wheel.install.
	install -D -m 0755 tools/install-tf-shim.sh \
		$(TUI)/usr/bin/logi-shim
	# The rotation proxy that installer stages with --range-proxy. Shipped
	# prebuilt because it is a Windows DLL and the people who need it run
	# Linux without a cross-compiler; unpackaged, --range-proxy told them
	# to run `make -C tools` in a directory a package user does not have.
	install -D -m 0644 tools/tf-range-proxy.dll \
		$(TUI)/usr/share/logitech-trueforce/tf-range-proxy.dll
	# The dinput8 escape proxy logi-launch stages into an SDK game's own
	# directory: it answers the SDK's range getters and relays the game's
	# RPM telemetry for the kernel texture merge. Prebuilt, same reason.
	install -D -m 0644 tools/dinput8-escape.dll \
		$(TUI)/usr/share/logitech-trueforce/dinput8-escape.dll
	# The RPM feed for the kernel texture merge; logi-launch starts and
	# stops it around a game session.
	install -D -m 0755 tools/logi-rpm-bridge \
		$(TUI)/usr/bin/logi-rpm-bridge
	# The one launch option every game uses: works out the per-game plan
	# and runs the whole recipe. Every other channel already shipped it;
	# the deb comments referenced it without installing it (issue #60's
	# class of missing-runtime reports).
	install -D -m 0755 tools/logi-launch.sh \
		$(TUI)/usr/bin/logi-launch
	# The TrueForce re-arm blob logi-launch replays under LOGI_TF_REARM=1.
	install -D -m 0644 tools/tf-init.bin \
		$(TUI)/usr/share/logitech-trueforce/tf-init.bin
	# The truck sims load this from inside the game rather than from a
	# Proton prefix, so it ships beside the proxy rather than in bin.
	install -D -m 0644 userspace/logi-wheel/target/release/liblogi_tf_scs.so \
		$(TUI)/usr/share/logitech-trueforce/liblogi_tf_scs.so
	# A Windows executable: it runs inside the game's Proton prefix.
	# Prebuilt because no distro builder ships a Rust Windows target.
	install -D -m 0644 tools/logi-tf-relay.exe \
		$(TUI)/usr/share/logitech-trueforce/logi-tf-relay.exe
	# G923 Xbox mode-switch helper, dispatched by udev rule 73. Must not be
	# run from the udev worker itself; see the rule's own comment.
	install -D -m 0755 tools/xbox-modeswitch.sh \
		$(TUI)/usr/bin/logi-wheel-modeswitch
	# The pre-0.38.0 name, kept as a symlink: issue #52 and the wiki both
	# tell people to run it by hand, and it now covers a second wheel
	# rather than becoming a second command.
	ln -sf logi-wheel-modeswitch $(TUI)/usr/bin/logi-g923-modeswitch
	# Rebinds a wheel that another driver claimed, which the settings apps'
	# diagnostics offer as a fix. Kept as a script rather than a command in the
	# app because a wheel presents several HID interfaces and all of them have
	# to be moved.
	install -D -m 0755 tools/rebind-wheel.sh \
		$(TUI)/usr/bin/logi-rebind-wheel
	# Steam launch-options wrapper: starts an in-prefix Windows helper
	# (logi-tf-relay, or a telemetry bridge) after the game is up. Useless
	# unless it is on PATH, because the whole point is that a user types
	# `logi-launch %command%` and nothing else.
	install -D -m 0755 tools/logi-launch.sh \
		$(TUI)/usr/bin/logi-launch
	# The transitional symlink for the pre-0.22.0 name is declared in
	# debian/logi-wheel.links, next to the other rename's symlink.
	# Everything else (udev rules, binaries, desktop entry, icon) comes
	# from the per-package debian/<pkg>.install lists.
	dh_install

override_dh_dkms:
	dh_dkms -V $(VER)
